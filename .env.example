# ── 무림여지도 환경변수 (복사해서 .env.local 로 저장하거나 Cloudflare Pages 설정에 입력)
NEXT_PUBLIC_SITE_URL=https://murim-yeojido.pages.dev
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# ── Google AdSense (승인 후 입력. 비워 두면 광고 코드가 아예 나가지 않음)
NEXT_PUBLIC_ADSENSE_CLIENT=            # ca-pub-로 시작하는 게시자 ID
NEXT_PUBLIC_AD_SLOT_DRAWER=            # 지도 문파 패널 하단 (디스플레이·반응형)
NEXT_PUBLIC_AD_SLOT_ARTICLE_TOP=       # 문파 상세 요약 아래 (콘텐츠 내 자동 삽입)
NEXT_PUBLIC_AD_SLOT_ARTICLE_BOTTOM=    # 문파 상세 본문 끝 (디스플레이·반응형)
NEXT_PUBLIC_AD_SLOT_FEED=              # 도감 목록 사이 (인피드)
NEXT_PUBLIC_AD_FEED_LAYOUT_KEY=        # 인피드 광고 레이아웃 키 (예: -6t+ed+2i-1n-4w)

# 1 이면 실제 광고 대신 점선 자리표시를 보여 줌 (레이아웃 확인용, 배포 시 0)
NEXT_PUBLIC_AD_PREVIEW=0
